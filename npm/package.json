{
  "name": "@muthuishere/huddle",
  "version": "0.1.0",
  "description": "The AI-native SDLC orchestrator: expert huddles, playbook artifacts, human gates and lifecycle hooks for coding agents.",
  "keywords": [
    "huddle",
    "agent",
    "skills",
    "claude",
    "codex",
    "sdlc",
    "personas",
    "cli"
  ],
  "homepage": "https://github.com/muthuishere/huddle-next",
  "bugs": {
    "url": "https://github.com/muthuishere/huddle-next/issues"
  },
  "author": "Muthukumaran Navaneethakrishnan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muthuishere/huddle-next.git"
  },
  "bin": {
    "huddle": "bin/huddle.js"
  },
  "scripts": {
    "postinstall": "node bin/huddle.js install --skills --json > /dev/null 2>&1 || exit 0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-LICENSES.md"
  ],
  "optionalDependencies": {
    "@muthuishere/huddle-darwin-arm64": "0.1.0",
    "@muthuishere/huddle-darwin-x64": "0.1.0",
    "@muthuishere/huddle-linux-arm64": "0.1.0",
    "@muthuishere/huddle-linux-x64": "0.1.0",
    "@muthuishere/huddle-windows-arm64": "0.1.0",
    "@muthuishere/huddle-windows-x64": "0.1.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "engines": {
    "node": ">=18"
  }
}
